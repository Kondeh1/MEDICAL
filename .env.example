# Copy to .env and fill in values. Never commit .env.

# Django
DEBUG=True
SECRET_KEY=your-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (development uses SQLite if DATABASE_URL is not set)
# DATABASE_URL=postgres://user:password@localhost:5432/telemedicine_db

# File uploads (optional)
# MEDIA_ROOT=media
# MEDIA_URL=/media/

# Email (optional, for production)
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
